{
  "name": "hari-krishna-talikota-website",
  "version": "2.0.0",
  "type": "module",
  "description": "Official website for Hari Krishna Talikota - iTDP Telangana State President",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js && node scripts/check-csp-hash.js",
    "preview": "vite preview",
    "photos": "python scripts/process-photos.py",
    "assets": "python scripts/generate-assets.py",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "fonts": "python scripts/fetch-fonts.py",
    "preview:prod": "node scripts/preview-prod.js",
    "origin": "node scripts/set-origin.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.47.1",
    "vite": "^5.1.0"
  }
}
